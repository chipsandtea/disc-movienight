# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
DISCORD_GUILD_ID=your_discord_server_id_here

# Channel Configuration
MOVIE_CHANNEL_NAME=shows-n-movies

# TMDB (The Movie Database) API Key (Free at themoviedb.org)
TMDB_API_KEY=your_tmdb_api_key_v3_here

# Database Configuration (SQLite file path)
DATABASE_URL=file:movienight.db

# Optional Admin Role ID
ADMIN_ROLE_ID=
